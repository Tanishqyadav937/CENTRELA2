# Encryption Keys (generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
RED_KEY=
BLUE_KEY=
LLM_KEY=
MASTER_KEY=

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bayora
POSTGRES_PASSWORD=bayora_password
POSTGRES_DB=bayora_audit

# Kafka
KAFKA_BROKER=localhost:9092

# JWT & Service Communication
JWT_SECRET=
SERVICE_SHARED_SECRET=

# Audit Service
AUDIT_SALT=audit_salt_change_me
AUDIT_SIGNING_KEY_B64=

# RSA Key Pair for LLM Proxy Session Key Wrapping
# Generate with: python3 bayora/infra/scripts/generate-llm-proxy-keys.py
LLM_PROXY_PUBLIC_KEY_B64=
LLM_PROXY_PRIVATE_KEY_B64=

# LLM Configuration
GOOGLE_API_KEY=
MOCK_LLM=0
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3
